# Persistent provider/model preference is managed via `shai config set-provider` /
# `shai config set-model` (stored in ~/.config/shai/config.json), not this file.
# SHAI_PROVIDER below is only a lower-priority fallback for one-off/CI use — leave it unset
# unless you specifically want to override the persisted config from your shell.
# SHAI_PROVIDER=ollama

# Ollama (local inference, no key needed)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Mistral (hosted inference, requires an API key from https://console.mistral.ai/)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
